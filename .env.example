# 212 部署变量示例。复制为 .env 后替换全部 CHANGE_ME；.env 只能留在本机与服务器。
# 打包脚本会把已确认的连接配置写入发布包内的私有 .env，终端不会打印密码。
# Copy to .env, then replace every CHANGE_ME value.
IMAGE_TAG=local
SPRING_PROFILES_ACTIVE=test
BIND_ADDRESS=0.0.0.0
HTTP_PORT=17878
TZ=Asia/Shanghai
JAVA_TOOL_OPTIONS='-Xms256m -Xmx2g -Duser.timezone=Asia/Shanghai'

# 212 existing MySQL/MariaDB. Container localhost is not the server host.
METADATA_URL='jdbc:mysql://192.168.0.212:3306/eltock?useUnicode=true&characterEncoding=UTF-8&connectionTimeZone=UTC&connectTimeout=5000&socketTimeout=30000'
METADATA_USERNAME=eltock
METADATA_PASSWORD='CHANGE_ME'

# Existing installations MUST keep their original app.secret-key.
APP_SECRET_KEY='CHANGE_ME'
ADMIN_USER=admin
ADMIN_PASSWORD='CHANGE_ME'

# ClickHouse 的协议与端口必须成对配置：
# - native + 9000：直连 ClickHouse 原生协议端口；
# - native + 9001：9001 由代理转发到原生 9000；
# - http   + 8123：直连 ClickHouse HTTP 端口；
# - http   + 8132：8132 由代理转发到 HTTP 8123。
# 每次容器启动都会用这些变量覆盖数据源连接，因此以 .env 为准。
CK_HOST=CHANGE_ME
CK_PROTOCOL=native
CK_PORT=9000
CK_DATABASE=default
CK_USERNAME=default
CK_PASSWORD=''
CK_SECURE=false

# CK account/role management identity. Must have ACCESS MANAGEMENT.
# Business queries never use this account.
CK_MANAGEMENT_USERNAME=CHANGE_ME
CK_MANAGEMENT_PASSWORD='CHANGE_ME'
CK_MANAGEMENT_ENABLED=true
# Only these databases may be provisioned/granted by the platform.
CK_DATABASES=ods_data,dwd_data
# external: existing MySQL/CK; standalone: bundled MySQL/CK.
# package.ps1 -Mode overrides this choice. Do not auto-fallback on connection errors.
DEPLOYMENT_MODE=external
