<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!-- 继承 Spring Boot 官方父 POM:统一管理 Spring Boot 依赖版本、插件与打包默认值。
       2.7.x 是最后一个支持 Java 8 的 Spring Boot 版本线,与本项目 java.version=1.8 对应。
       relativePath 置空表示不找本地相对路径的父 POM,一律从仓库解析。 -->
  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>2.7.18</version>
    <relativePath/>
  </parent>

  <!-- 本项目坐标;最终产物名由 <build><finalName> 决定为 el-to-ck-server -->
  <groupId>com.el2ck</groupId>
  <artifactId>el-to-ck</artifactId>
  <version>1.0.0</version>
  <name>el-to-ck</name>
  <description>数据同步平台(ClickHouse) - Java/Spring Boot 迁移版</description>

  <!-- 源码/字节码统一 Java 8,并固定源码与报告输出编码为 UTF-8(避免中文注释乱码) -->
  <properties>
    <!-- Spring Boot 父 POM 读取该属性设置编译级别 -->
    <java.version>1.8</java.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
    <!-- 显式声明编译器 source/target:第三方插件(如 lombok 之外的工具)不以 java.version 为准,
         双写可确保所有编译路径都落在 Java 8 字节码 -->
    <maven.compiler.source>1.8</maven.compiler.source>
    <maven.compiler.target>1.8</maven.compiler.target>
  </properties>

  <!-- ===================================================================
       仅在「用 JDK 9+ 构建」时追加 API 校验(见下方 java9plus-api-check profile)。
       背景:source/target 只限制语法,不校验 API —— 在 JDK 17 上编译时,源码里写
       Path.of() 这类 Java 11 才有的方法照样编得过,直到换 JDK 8 编译/运行才炸。
       但不能把 release 参数写死在这里:javac 8 根本不认它(会直接 BUILD FAILURE),
       而本项目的运行环境正是 JDK 8。
       =================================================================== -->
  <profiles>
    <profile>
      <id>java9plus-api-check</id>
      <!-- [9,) 表示 JDK 9 及以上;JDK 8 构建时整个 profile 不生效 -->
      <activation>
        <jdk>[9,)</jdk>
      </activation>
      <properties>
        <!-- javac 按 Java 8 的 API 清单(ct.sym)校验,越界 API 在编译期即报错 -->
        <maven.compiler.release>8</maven.compiler.release>
      </properties>
    </profile>
  </profiles>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-security</artifactId>
    </dependency>
    <!-- Web 层:内嵌 Tomcat + Spring MVC + Jackson,提供 REST 接口并托管前端静态资源 -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>

    <!-- XXL-JOB 执行器：定时任务由 XXL-JOB Admin 调度，服务端只负责执行任务 -->
    <dependency>
      <groupId>com.xuxueli</groupId>
      <artifactId>xxl-job-core</artifactId>
      <version>2.4.1</version>
    </dependency>

    <!-- 数据访问:MyBatis(Java8/Boot2.7 兼容版本)。由 mybatis-spring-boot-starter 自带
         spring-boot-starter-jdbc(DataSource 仍由我们自建,见 config/InfrastructureConfiguration)。 -->
    <dependency>
      <groupId>org.mybatis.spring.boot</groupId>
      <artifactId>mybatis-spring-boot-starter</artifactId>
      <version>2.3.2</version>
    </dependency>

    <!-- ClickHouse native/TCP JDBC driver (9000), resolved by Maven. -->
    <dependency>
      <groupId>com.github.housepower</groupId>
      <artifactId>clickhouse-native-jdbc</artifactId>
      <version>2.6.4</version>
    </dependency>

    <!-- ClickHouse HTTP JDBC 驱动(8123,官方驱动)。
         与上面的 native 驱动并存:native 仍是默认协议,这里只为「连接可选 HTTP」提供实现。
         选 0.6.3 是因为:①本机 .m2 已缓存,离线构建可用;
         ②它是规范的多版本 jar(Multi-Release: true,Java 11 类全在 META-INF/versions/11/ 下,
           基础树全部为 Java 8 字节码),因此在 JRE 8 运行环境里可安全加载。 -->
    <dependency>
      <groupId>com.clickhouse</groupId>
      <artifactId>clickhouse-jdbc</artifactId>
      <version>0.6.3</version>
    </dependency>

    <!-- ClickHouse HTTP 驱动的响应压缩实现(LZ4)。
         ⚠️ 这不是可选项:驱动默认 compress_algorithm=lz4,而 clickhouse-data 的 POM 刻意把
         lz4-java 排除在传递依赖之外,由使用方自己提供。缺失时查询会【直接失败】而不是降级:
           LZ4 is not supported. Please disable compression(compress=0) ...
         native 驱动用的 io.airlift:aircompressor 是另一套实现,替代不了它。 -->
    <dependency>
      <groupId>org.lz4</groupId>
      <artifactId>lz4-java</artifactId>
      <version>1.8.0</version>
    </dependency>

    <!-- 仅用于旧 SQLite 文件只读诊断与兼容测试 -->
    <dependency>
      <groupId>org.xerial</groupId>
      <artifactId>sqlite-jdbc</artifactId>
      <version>3.45.1.0</version>
    </dependency>

    <!-- CSV 逻辑记录解析：流式处理引号、转义和字段内换行，Java 8 兼容。 -->
    <dependency>
      <groupId>org.apache.commons</groupId>
      <artifactId>commons-csv</artifactId>
      <version>1.10.0</version>
    </dependency>

    <!-- 内嵌 DuckDB(CSV/JSON 预览与工作流物化) -->
    <!-- 以进程内嵌入式方式运行,无需额外服务;用于数据预览、列类型推断与中间结果落地 -->
    <dependency>
      <groupId>org.duckdb</groupId>
      <artifactId>duckdb_jdbc</artifactId>
      <version>0.10.3</version>
    </dependency>

    <!-- Excel(.xlsx/.xls)数据源读取:本地转成临时 CSV 后再走 DuckDB read_csv 解析 -->
    <!-- poi-ooxml 同时含 poi 主体与 OOXML 实现,故无需再单独引入 poi -->
    <dependency>
      <groupId>org.apache.poi</groupId>
      <artifactId>poi-ooxml</artifactId>
      <version>5.2.5</version>
    </dependency>

    <dependency>
      <groupId>org.apache.kafka</groupId>
      <artifactId>kafka-clients</artifactId>
      <version>3.9.1</version>
    </dependency>
    <dependency>
      <groupId>org.apache.hive</groupId>
      <artifactId>hive-jdbc</artifactId>
      <version>4.0.1</version>
      <classifier>standalone</classifier>
      <exclusions>
        <exclusion><groupId>*</groupId><artifactId>*</artifactId></exclusion>
      </exclusions>
    </dependency>

    <!-- 数据源远程探测(mysql/pgsql/mongodb/sftp) -->
    <!-- 仅用于「测试连接」与元数据探测,业务数据同步仍走 ClickHouse native 驱动 -->
    <dependency>
      <groupId>com.mysql</groupId>
      <artifactId>mysql-connector-j</artifactId>
      <version>8.0.33</version>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <version>42.7.3</version>
    </dependency>
    <!-- MongoDB 驱动:sync 面向应用,core 为底层协议实现,bson 负责文档编解码;
         显式列全 4 个(含 bson-record-codec)是为了版本对齐,避免传递解析出不一致的 bson -->
    <dependency>
      <groupId>org.mongodb</groupId>
      <artifactId>mongodb-driver-sync</artifactId>
      <version>4.11.1</version>
    </dependency>
    <dependency>
      <groupId>org.mongodb</groupId>
      <artifactId>mongodb-driver-core</artifactId>
      <version>4.11.1</version>
    </dependency>
    <dependency>
      <groupId>org.mongodb</groupId>
      <artifactId>bson</artifactId>
      <version>4.11.1</version>
    </dependency>
    <dependency>
      <groupId>org.mongodb</groupId>
      <artifactId>bson-record-codec</artifactId>
      <version>4.11.1</version>
    </dependency>
    <!-- 数据源远程探测(sftp):JSch 提供 SSH/SFTP 会话,用于远端文件型数据源的浏览与拉取 -->
    <dependency>
      <groupId>com.jcraft</groupId>
      <artifactId>jsch</artifactId>
      <version>0.1.55</version>
    </dependency>

    <!-- 程序算子用的国密 SM3:JDK 不提供该算法,ClickHouse 也没有(SM3 必须由本程序计算)。
         用成熟实现而不是自写 —— 计划文档明确禁止自写简化算法,加密算法的测试向量必须能逐字节对上。
         版本 1.67 是本地仓库已有的版本(离线构建可用)。 -->
    <dependency>
      <groupId>org.bouncycastle</groupId>
      <artifactId>bcprov-jdk15on</artifactId>
      <version>1.67</version>
    </dependency>

    <!-- JDK 15+ 已移除内置 Nashorn；工作流“代码块”节点通过 JSR-223 使用该兼容实现。 -->
    <dependency>
      <groupId>org.openjdk.nashorn</groupId>
      <artifactId>nashorn-core</artifactId>
      <!-- 15.4 产物要求 Java 11；本项目运行目标为 Java 8。 -->
      <version>15.3</version>
    </dependency>

    <!-- 编译期样板代码:@Data/@Slf4j 等,仅编译时需要,不进入运行时产物 -->
    <dependency>
      <groupId>org.projectlombok</groupId>
      <artifactId>lombok</artifactId>
      <scope>provided</scope>
    </dependency>

  </dependencies>

  <build>
    <!-- 产物文件名固定为 el-to-ck-server(与启动脚本/部署约定保持一致),不受 artifactId-version 影响 -->
    <finalName>el-to-ck-server</finalName>
    <plugins>
      <!-- 打成可执行 fat jar(内嵌 Tomcat),用 java -jar 即可启动 -->
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
